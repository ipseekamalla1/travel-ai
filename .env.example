# AI Travel Universe — environment template. Copy to `.env` (git-ignored) and adjust.
# Never commit real secrets. Server-only secrets must NOT use the NEXT_PUBLIC_ prefix.

# ---------- Core ----------
# local | test | staging | production
APP_ENV=local
LOG_LEVEL=INFO
# true in deployed environments
LOG_JSON=false
WEB_BASE_URL=http://localhost:3000
# comma-separated; empty = same-origin only (web proxies /api)
CORS_ORIGINS=

# ---------- Ports (host side, docker compose) ----------
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------- Database / cache ----------
POSTGRES_USER=atu
POSTGRES_PASSWORD=atu
POSTGRES_DB=atu
# Used when running the API on the host (`make api`); compose sets its own internal URL.
DATABASE_URL=postgresql+asyncpg://atu:atu@localhost:5432/atu
REDIS_URL=redis://localhost:6379/0
# Test suite (separate database, created by infra/docker/postgres-init)
TEST_DATABASE_URL=postgresql+asyncpg://atu:atu@localhost:5432/atu_test
TEST_REDIS_URL=redis://localhost:6379/15

# ---------- Auth ----------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# ---------- Providers ----------
# fake (dev/test fixtures) | real
PROVIDERS_MODE=fake

# ---------- AI (Phase 9+) ----------
OPENAI_API_KEY=
AI_MODEL_SIMPLE=
AI_MODEL_STANDARD=
AI_MODEL_ADVANCED=
AI_MODEL_VISION=
AI_MODEL_EMBEDDING=
AI_MONTHLY_BUDGET_USD=50
AI_USER_DAILY_REQUEST_LIMIT=200

# ---------- Places / geocoding / routing / weather (Phase 5+) ----------
# server-only: Places API (New) + Geocoding
GOOGLE_MAPS_API_KEY=
# server-only
OPENROUTESERVICE_API_KEY=
# no key needed for Open-Meteo
WEATHER_PROVIDER=open_meteo

# ---------- Storage (Phase 17) ----------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./var/storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# ---------- Web ----------
# server-side rewrite target for /api/*
API_INTERNAL_URL=http://localhost:8000
# Public, domain-restricted MapTiler key — tiles only (ADR-006). Nothing else may be public.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_TILES_KEY=

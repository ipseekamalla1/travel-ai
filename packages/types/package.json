    ".": "./src/index.ts"
  },
  "scripts": {
    "gen": "node ./scripts/generate.mjs",
    "check": "node ./scripts/generate.mjs --check"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
